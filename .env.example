# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# Base config: .env. Overrides per environment: .env.${ENV} (e.g. .env.production).
ENV=local
APP_NAME=Croupier RAG API
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=
# Comma separated or JSON array.
CORS_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_MB=50
CROP_MARGIN_PT=12
CROP_DPI=150
IMAGE_MIN_SIZE_PT=50
IMAGE_DPI=150

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=manual_chunks

# ---------------------------------------------------------------------------
# LLM: LLM_PROVIDER decides the adapter (gemini | ollama | openai)
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Embeddings (local by default; no network at query time once cached)
# EMBEDDING_PROVIDER: fastembed | ollama | gemini
# For ollama/gemini set EMBEDDING_MODEL and EMBEDDING_DIM to that provider's
# model (e.g. nomic-embed-text / gemini-embedding-001).
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
SPARSE_EMBEDDING_LANGUAGE=spanish

# ---------------------------------------------------------------------------
# Chunking / retrieval
# ---------------------------------------------------------------------------
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
EMBED_BATCH_SIZE=32
RETRIEVAL_TOP_K=8
RETRIEVAL_PREFETCH_LIMIT=30
RETRIEVAL_MIN_SCORE=0.30
RRF_K=60

# ---------------------------------------------------------------------------
# Resilience (seconds unless stated otherwise)
# ---------------------------------------------------------------------------
LLM_TIMEOUT_S=60
EMBEDDING_TIMEOUT_S=30
VECTOR_STORE_TIMEOUT_S=15
HTTP_MAX_RETRIES=3
HTTP_RETRY_BASE_S=0.4
HTTP_RETRY_MAX_S=8
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_S=30

# ---------------------------------------------------------------------------
# Chat / conversations
# ---------------------------------------------------------------------------
# Maximum previous turn pairs sent to the rewriter and answer prompt.
CHAT_HISTORY_TURNS=6
CONVERSATION_PREFIX=croupier:conversation:
CONVERSATION_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Jobs / SSE
# ---------------------------------------------------------------------------
JOB_STATE_TTL_SECONDS=86400
SSE_HEARTBEAT_S=15
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BASE_S=2
INGESTION_RETRY_MAX_S=60
INGESTION_SOFT_TIME_LIMIT_S=600
INGESTION_TIME_LIMIT_S=660
